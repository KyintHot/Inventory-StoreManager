# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API). Without it the app shows a "Supabase is not configured" screen.

# --- Browser (public) ------------------------------------------------------
# Safe to expose: these ship to the client bundle and are protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Server only (Vercel function: api/invite-user.ts) ---------------------
# NEVER prefix these with VITE_ and never commit real values. The service-role key
# bypasses Row Level Security — keep it out of the browser at all costs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: your production URL, if it differs from the request host.
# SITE_URL=https://your-app.vercel.app
